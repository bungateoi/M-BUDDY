# URL backend AI (GreenNode AgentBase runtime, xem /agent/SPEC.md).
# Local dev: http://localhost:8080 (chạy `python3 main.py` trong /agent)
# Production: endpoint runtime đã deploy, xem /agent/.agentbase-state.json
EXPO_PUBLIC_BACKEND_URL=

# Tài khoản + database thật (Supabase — xem supabase/migrations/0001_init.sql).
# Lấy 2 giá trị này ở Supabase Dashboard > Project Settings > API.
# CHỈ dùng khoá "anon public" — KHÔNG bao giờ nhúng "service_role" vào app.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
