GREENNODE_CLIENT_ID=
GREENNODE_CLIENT_SECRET=
GREENNODE_AGENT_IDENTITY=
# LLM provider config (any OpenAI-compatible provider)
# For GreenNode AIP: use /agentbase-llm to get API key and set LLM_BASE_URL=https://maas-llm-aiplatform-hcm.api.vngcloud.vn/v1
# For OpenAI: set LLM_BASE_URL=https://api.openai.com/v1
# For Ollama: set LLM_BASE_URL=http://localhost:11434/v1 (no key needed)
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# Chỉ cần cho /admin/products, /admin/personas (màn "Quản trị hành trình &
# tri thức") — verify_admin() dùng SUPABASE_SERVICE_ROLE_KEY để tự xác thực
# người gọi là admin + ghi thẳng vào DB (bỏ qua RLS). LẤY Ở Supabase
# Dashboard > Project Settings > API > service_role key — KHÔNG PHẢI anon
# key, và KHÔNG BAO GIỜ dùng key này ở phía client/app. Thiếu 2 biến này thì
# roleplay/score/generate-persona vẫn chạy bình thường, chỉ /admin/* lỗi 500.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
